# Include template and documentation files
include config.yaml.template
include README.md
include requirements.txt

include *.md

# Runtime YAML assets (prompts + model configs) loaded via PROMPTS.get /
# load_yaml. Without these in the sdist, installed wheels fail with missing
# prompt-key errors at command time.
recursive-include litassist/prompts *.yaml
recursive-include litassist/llm *.yaml

# Include example files
recursive-include examples *.txt *.pdf

# Include documentation
recursive-include article *.pdf *.tex

# Exclude test and development files
exclude test-scripts/test_*.py
exclude test-scripts/run_tests.sh
exclude test-scripts/*.sh
exclude cleanup.zsh

# Exclude logs and temporary files
global-exclude *.log
global-exclude *.tmp
global-exclude *_results_*.json
global-exclude __pycache__
global-exclude *.py[co]
