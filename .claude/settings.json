{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -c *)",
      "Bash(.venv/bin/pytest -p *)",
      "Bash(/Users/witt/.local/bin/litassist *)",
      "Bash(echo \"=== global config present? ===\" *)",
      "Bash(PATH=/Users/witt/.local/bin:__TRACKED_VAR__ litassist extractfacts complaint_scenario.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/model-identifier-warn.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/log-coverage.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": ".claude/hooks/yaml-lint-prompts.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
