{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/model-identifier-warn.sh\"",
            "timeout": 5
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 30
          }
        ],
        "matcher": "Edit|Write|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/log-coverage.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/yaml-lint-prompts.sh\"",
            "timeout": 10
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10
          }
        ],
        "matcher": ""
      }
    ]
  }
}
